# PostgreSQL
POSTGRES_USER=tennis_atlas
POSTGRES_PASSWORD=tennis_atlas_dev
POSTGRES_DB=tennis_atlas_dev
POSTGRES_PORT=5432

# Phoenix API
# API_PORT and the port in PUBLIC_API_URL must stay in sync — if you change
# API_PORT, update the port in PUBLIC_API_URL to match.
API_PORT=4000

# SvelteKit web
# WEB_PORT must match the CORS origin hardcoded in
# apps/api/lib/tennis_atlas_api_web/endpoint.ex (http://localhost:5173) — if
# you change WEB_PORT, update that origin too.
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:4000
